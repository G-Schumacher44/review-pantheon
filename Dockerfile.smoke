# Dockerfile.smoke — clean-machine, real-Linux smoke test for review-pantheon's setup story.
#
# Proves the dependency list in docs/SETUP.md's Prerequisites table is complete, and exercises
# real GNU coreutils/Linux behavior this repo's macOS-based development can't exercise directly.
#
# No --platform pin here on purpose: built natively for whatever arch runs `docker build`
# (arm64 on Apple Silicon dev machines, amd64 on this repo's GitHub Actions runners).
#
# Usage:
#   docker build -f Dockerfile.smoke -t review-pantheon-smoke .
#   docker run --rm review-pantheon-smoke
#   # with a token, to also exercise Stage 5 (tokened live dry-run):
#   docker run --rm -e GH_TOKEN="$GH_TOKEN" review-pantheon-smoke
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        # jq: consumed ONLY by tests/test-verdict-decision-python.sh's harness (parses the
        # decider's JSON at its lines 41-42) — NOT a runtime dependency of pantheon itself;
        # pantheon/jqjson.py exists precisely to remove the runtime need. Removing this once
        # turned every verdict fixture into PARSE_FAILURE in-container (PR #67).
        jq \
        curl \
        python3 \
        python3-yaml \
        python3-pip \
        python3-venv \
        ca-certificates \
        shellcheck \
        gnupg \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && apt-get purge -y gnupg \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /review-pantheon
COPY . .

RUN chmod +x install.sh bootstrap.sh tests/*.sh

ENTRYPOINT ["tests/test-setup-smoke.sh"]
