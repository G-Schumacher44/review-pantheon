# review-pantheon gate config — copy to gate.conf at your repo root and edit.
# Simple key=value, one per line. Blank lines and lines starting with # are ignored.
# Every key is optional; the runner falls back to the defaults shown here.

# Provider lane — one of the files in cli/providers/ (without the .sh extension).
provider=claude

# Lane-specific model id. Empty means "let the lane pick its own default".
model=

# Branch the review diff is computed against.
base_branch=main

# Path (relative to the target repo root) to the house-rules file agents treat as
# blocker-class checks. See REVIEW_RULES.example.md for the shipped starting point.
rules_file=REVIEW_RULES.md

# Path (relative to the target repo root) to the governing design/spec doc. Only used if the
# file is actually present there — when it is, Apollo's context (only Apollo's, no other
# agent's) gets a pointer to it and an instruction to check the delivered change against the
# sections relevant to what changed. Default: DESIGN.md. Set to empty (spec_file=) to disable.
spec_file=DESIGN.md

# Space-separated list of agents to run for the standard gate.
agents=artemis apollo

# Tool-execution tier for the underlying `claude` invocation: "readonly" (the default) scopes
# Bash to a read-only git allowlist (diff/show/log/status) so reviewing a hostile fork's diff
# never grants an agent arbitrary command execution. "trusted" restores full Bash — reserve it
# for own-repo/trusted-author use only, NEVER for reviewing a fork PR you don't control. See
# DESIGN.md's "Security posture".
execution=readonly
